<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>

<AnchorPane prefHeight="700.0" prefWidth="1000.0" style="-fx-background-color: #f1f5f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="shoedeliverysystem2.controller.AdminDashboardController">
   <children>
      <VBox spacing="25.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
         <children>
            <Text text="Business Overview" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-fill: #1e293b;" />
            
            <HBox spacing="20.0">
               <children>
                  <VBox prefWidth="300.0" style="-fx-background-color: #10b981; -fx-background-radius: 10; -fx-padding: 20;">
                     <children>
                        <Label text="Total Revenue" textFill="WHITE" style="-fx-font-size: 16;" />
                        <Label fx:id="totalRevenueLabel" text="0 ETB" textFill="WHITE" style="-fx-font-size: 32; -fx-font-weight: bold;" />
                     </children>
                  </VBox>
                  <VBox prefWidth="300.0" style="-fx-background-color: #3b82f6; -fx-background-radius: 10; -fx-padding: 20;">
                     <children>
                        <Label text="Total Orders" textFill="WHITE" style="-fx-font-size: 16;" />
                        <Label fx:id="totalOrdersLabel" text="0" textFill="WHITE" style="-fx-font-size: 32; -fx-font-weight: bold;" />
                     </children>
                  </VBox>
                  <VBox prefWidth="300.0" style="-fx-background-color: #f59e0b; -fx-background-radius: 10; -fx-padding: 20;">
                     <children>
                        <Label text="Pending Deliveries" textFill="WHITE" style="-fx-font-size: 16;" />
                        <Label fx:id="pendingOrdersLabel" text="0" textFill="WHITE" style="-fx-font-size: 32; -fx-font-weight: bold;" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;" VBox.vgrow="ALWAYS">
               <children>
                  <Text text="Sales Performance by Brand" style="-fx-font-size: 18; -fx-font-weight: bold;" />
                  <BarChart fx:id="salesChart" VBox.vgrow="ALWAYS">
    <xAxis>
        <CategoryAxis label="Shoe Brand" side="BOTTOM" />
    </xAxis>
    <yAxis>
        <NumberAxis label="Revenue (ETB)" side="LEFT" />
    </yAxis>
</BarChart>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>